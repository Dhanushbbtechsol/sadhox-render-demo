# Local template — copy to `.env` (gitignored). Never commit real secrets.
# Host ports match docker-compose.yml publish mappings.
DATABASE_URL=postgresql://sadhox:sadhox@127.0.0.1:5437/sadhox
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
PORT=3000
REDIS_URL=redis://127.0.0.1:16379
JWT_ACCESS_SECRET=change-me-access-secret-min-16
JWT_REFRESH_SECRET=change-me-refresh-secret-16
RESEND_API_KEY=
MAIL_FROM=
SENTRY_DSN=
LOG_LEVEL=info
# Ticket auto-close (Phase 3 Day 13)
AUTO_CLOSE_CRON=0 2 * * *
AUTO_CLOSE_DAYS=3
# Pool / throttle (defaults shown; raise for Day 17 load tests only)
DB_POOL_MAX=10
THROTTLE_GLOBAL_LIMIT=100
THROTTLE_GLOBAL_TTL_MS=60000
