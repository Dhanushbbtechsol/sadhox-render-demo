    "package.json": "{\n  \"name\": \"sadhox\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"workspaces\": [\n    \"apps/*\",\n    \"packages/*\"\n  ],\n  \"scripts\": {\n    \"dev\": \"pnpm -r dev\",\n    \"build\": \"pnpm -r build\",\n    \"check-types\": \"pnpm -r --if-present check-types\",\n    \"dev:web\": \"pnpm --filter web dev\",\n    \"dev:server\": \"pnpm --filter server dev\"\n  },\n  \"packageManager\": \"pnpm@10.17.1\",\n  \"dependencies\": {\n    \"dotenv\": \"catalog:\",\n    \"zod\": \"catalog:\",\n    \"@sadhox/env\": \"workspace:*\"\n  },\n  \"devDependencies\": {\n    \"typescript\": \"^6.0.3\",\n    \"@types/node\": \"catalog:\",\n    \"@sadhox/config\": \"workspace:*\",\n    \"vercel\": \"^54.18.2\"\n  }\n}\n",
