    "apps/server/package.json": "{\n  \"name\": \"server\",\n  \"main\": \"src/index.ts\",\n  \"type\": \"module\",\n  \"scripts\": {\n    \"build\": \"tsdown\",\n    \"check-types\": \"tsc -b\",\n    \"compile\": \"bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server\",\n    \"dev\": \"tsx watch src/index.ts\",\n    \"start\": \"node dist/index.js\"\n  },\n  \"dependencies\": {\n    \"dotenv\": \"catalog:\",\n    \"zod\": \"catalog:\",\n    \"@sadhox/env\": \"workspace:*\",\n    \"hono\": \"^4.12.27\",\n    \"@hono/node-server\": \"^2.1.1\",\n    \"resend\": \"^6.22.0\",\n    \"@react-email/components\": \"^1.0.12\",\n    \"react-email\": \"^6.9.2\",\n    \"react\": \"catalog:\"\n  },\n  \"trustedDependencies\": [\n    \"supabase\"\n  ],\n  \"devDependencies\": {\n    \"typescript\": \"^6.0.3\",\n    \"tsdown\": \"^0.22.3\",\n    \"@sadhox/config\": \"workspace:*\",\n    \"tsx\": \"^4.23.12\",\n    \"@types/node\": \"catalog:\",\n    \"@types/react\": \"catalog:\"\n  }\n}\n",
